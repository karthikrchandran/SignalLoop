PROJECT_NAME=SignalLoop ARA Global
ENVIRONMENT=production
SECRET_KEY=<long-random-secret-for-signalloop-ara>
FIRST_SUPERUSER=karthik@ara-global.demo.local
FIRST_SUPERUSER_PASSWORD=<unique-long-password>
FRONTEND_HOST=https://signalloop-ara-global.example.com
SERVER_HOST=api-signalloop-ara-global.example.com
BACKEND_CORS_ORIGINS=["https://signalloop-ara-global.example.com"]
VITE_API_URL=https://api-signalloop-ara-global.example.com
POSTGRES_SERVER=<ara-signalloop-postgres-host>
POSTGRES_PORT=5432
POSTGRES_DB=signalloop_ara_global
POSTGRES_USER=<ara-signalloop-postgres-user>
POSTGRES_PASSWORD=<ara-signalloop-postgres-password>
REDIS_URL=redis://127.0.0.1:6379/0
DEFAULT_WORKSPACE_ID=workspace_ara_global
ECRM_INSTALLATION_ENDPOINTS={"ara-global":{"ecrm_cell_id":"cell_ara_global","ecrm_cell_key":"ara-global","base_url":"https://ecrm-ara-global.example.com"}}
ECRM_INSTALLATION_SECRET_REFERENCES={"ara-global-delivery-v1":{"ecrm_cell_id":"cell_ara_global","environment_name":"ECRM_ARA_GLOBAL_DELIVERY_TOKEN"}}
ECRM_ARA_GLOBAL_DELIVERY_TOKEN=<paste-ecrm-issued-signal-loop-delivery-token>
ECRM_INSTALLATION_PROJECTION_POLL_INTERVAL_SECONDS=10
ECRM_INSTALLATION_PROJECTION_BATCH_SIZE=100

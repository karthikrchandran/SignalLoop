PROJECT_NAME=SignalLoop AI Consulting
ENVIRONMENT=production
SECRET_KEY=<long-random-secret-for-signalloop-ai-consulting>
FIRST_SUPERUSER=karthik@ai-consulting.demo.local
FIRST_SUPERUSER_PASSWORD=<unique-long-password>
FRONTEND_HOST=https://signalloop-ai-consulting.example.com
SERVER_HOST=api-signalloop-ai-consulting.example.com
BACKEND_CORS_ORIGINS=["https://signalloop-ai-consulting.example.com"]
VITE_API_URL=https://api-signalloop-ai-consulting.example.com
POSTGRES_SERVER=<ai-consulting-signalloop-postgres-host>
POSTGRES_PORT=5432
POSTGRES_DB=signalloop_ai_consulting
POSTGRES_USER=<ai-consulting-signalloop-postgres-user>
POSTGRES_PASSWORD=<ai-consulting-signalloop-postgres-password>
REDIS_URL=redis://127.0.0.1:6379/0
DEFAULT_WORKSPACE_ID=workspace_ai_consulting
ECRM_INSTALLATION_ENDPOINTS={"ai-consulting":{"ecrm_cell_id":"cell_ai_consulting","ecrm_cell_key":"ai-consulting","base_url":"https://ecrm-ai-consulting.example.com"}}
ECRM_INSTALLATION_SECRET_REFERENCES={"ai-consulting-delivery-v1":{"ecrm_cell_id":"cell_ai_consulting","environment_name":"ECRM_AI_CONSULTING_DELIVERY_TOKEN"}}
ECRM_AI_CONSULTING_DELIVERY_TOKEN=<paste-ecrm-issued-signal-loop-delivery-token>
ECRM_INSTALLATION_PROJECTION_POLL_INTERVAL_SECONDS=10
ECRM_INSTALLATION_PROJECTION_BATCH_SIZE=100
